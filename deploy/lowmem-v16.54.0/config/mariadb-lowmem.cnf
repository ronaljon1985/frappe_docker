[mysqld]
# Memory profile for a 2 GiB host. MariaDB 11.8.9 rejects innodb_redo_log_capacity.
# Character set and snapshot isolation stay on the server command line,
# matching upstream frappe_docker.
skip_name_resolve
innodb_buffer_pool_size = 128M
max_connections = 50
performance_schema = OFF
table_open_cache = 200
table_definition_cache = 400
key_buffer_size = 8M
tmp_table_size = 16M
max_heap_table_size = 16M
thread_cache_size = 8
aria_pagecache_buffer_size = 8M
